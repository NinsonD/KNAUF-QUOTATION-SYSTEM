datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model KnaufSystem {
  id                  String           @id @default(cuid())
  code                String           @unique
  name                String
  category            String           // "CEILING", "PARTITION", "SHAFT_WALL", "WALL_LINING"
  description         String?
  supportsDeflection  Boolean          @default(false)
  materials           SystemMaterial[]
  quotations          Quotation[]
  createdAt           DateTime         @default(now())
}

model SystemMaterial {
  id               String       @id @default(cuid())
  systemId         String
  system           KnaufSystem  @relation(fields: [systemId], references: [id], onDelete: Cascade)
  productName      String
  factorPerM2      Float
  unit             String       // "m²", "m", "pcs", "kg"
  isHeadDeflection Boolean      @default(false)
  sortOrder        Int          @default(0)

  @@index([systemId])
}

model MasterProductPrice {
  id               String       @id @default(cuid())
  productName      String       @unique
  unit             String
  defaultPriceAed  Float
  updatedAt        DateTime     @updatedAt
}

model Quotation {
  id                  String          @id @default(cuid())
  quoteNumber         String          @unique // e.g. "ANM-2026-001"
  projectName         String
  clientName          String
  salesman            String          @default("Ram")
  scaleM2             Float
  systemId            String
  system              KnaufSystem     @relation(fields: [systemId], references: [id])
  includeDeflection   Boolean         @default(false)
  technicalParameters String          @default("{}")
  calculationVersion  String          @default("legacy")
  
  // Computed financial snapshots
  baseTotalAed        Float
  baseRatePerM2       Float
  deflectionTotalAed  Float?
  deflectionRatePerM2 Float?
  grandTotalAed       Float
  grandRatePerM2      Float
  
  status              String          @default("DRAFT") // DRAFT, ISSUED, APPROVED, REVISED, CANCELLED
  items               QuotationItem[]
  termsAndConditions  String          @default("[]") // JSON stringified array of terms
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  userId              String?
  user                User?           @relation(fields: [userId], references: [id])
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  name          String
  passwordHash  String
  role          String       @default("ESTIMATOR") // "ADMIN", "ESTIMATOR", "SALES", "VIEWER"
  avatarUrl     String?
  mustChangePassword Boolean @default(false)
  sessionVersion Int @default(0)
  sessions      AuthSession[]
  quotations    Quotation[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model QuotationItem {
  id               String       @id @default(cuid())
  quotationId      String
  quotation        Quotation    @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productName      String
  factorPerM2      Float
  factorOverridden Boolean      @default(false)
  unit             String
  totalQuantity    Float
  unitPriceAed     Float
  totalPriceAed    Float
  isHeadDeflection Boolean      @default(false)
  sortOrder        Int          @default(0)

  @@index([quotationId])
}

model AuthSession {
  tokenHash String @id
  sessionVersion Int @default(0)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt DateTime
  @@index([userId])
  @@index([expiresAt])
}

model AuthRateLimit {
  key String @id
  attempts Int @default(1)
  expiresAt DateTime
  @@index([expiresAt])
}
